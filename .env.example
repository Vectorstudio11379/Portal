# ==============================================================================
# VECTORSTUDIO AGENCY OS — SUPABASE ENVIRONMENT CONFIGURATION
# ==============================================================================

# Public Supabase API configuration for Vite frontend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: PostgreSQL Database Connection String for automated table migrations
# Found in Supabase Dashboard > Project Settings > Database > Connection String (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
